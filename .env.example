# TrackPoli admin — local/example environment. Copy to .env.local and fill in. NEVER commit real values.
# Secrets (service-role key, SMTP password, Turnstile secret, Google client secret) live ONLY in the
# service's own settings (Supabase / Vercel / Edge Function secrets), never here and never in the browser.
# See the Phase 1 plan, section 1 (Environment variables).

# --- Browser-exposed (NEXT_PUBLIC_*). Only server code reads the anon key; the browser never calls Supabase. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000/admin
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server only (Vercel server env). Never exposed to the browser. ---
APP_URL=http://localhost:3000/admin
INTERNAL_CALL_SECRET=

# --- Edge Function secrets (set in Supabase, listed here for reference only; do not put real values here) ---
# SUPABASE_URL, SUPABASE_ANON_KEY  (provided by Supabase at runtime)
# SUPABASE_SERVICE_ROLE_KEY        (Edge Functions + CI only)
# ALLOWED_ORIGINS                  (exact origins; normally empty; never *)
# SENTRY_DSN
# TURNSTILE_SECRET_KEY
